# Public configuration. Supabase URL and a publishable key are NOT secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is supported as a fallback; never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only: required for inspected media uploads, authorized media signing, jobs/cleanup, and account deletion.
# Supabase secret key (sb_secret_...) or the legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
# Random 32+ character bearer secret for /api/jobs/reminders, never public.
CRON_SECRET=
# Optional standards-based Web Push (generate: npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Optional Capacitor remote HTTPS web origin; never use an untrusted host.
CAPACITOR_SERVER_URL=
# Owner must replace these before store submission and domain association.
CAPACITOR_APP_ID=io.github.mgnoies12.himandi

# Optional framework tooling telemetry opt-out (not a secret).
NEXT_TELEMETRY_DISABLED=1
